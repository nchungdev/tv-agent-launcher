<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/hudBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="360dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bot_speech_hud"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/hudTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="@font/sans_medium"
            android:letterSpacing="0.04"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hudMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:fontFamily="@font/sans_regular"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <com.gathin.tvhome.feature.agent.widget.DuinchView
        android:id="@+id/hudDuinchBot"
        android:layout_width="56dp"
        android:layout_height="44dp"
        android:focusable="false"
        android:clickable="false" />
</LinearLayout>
