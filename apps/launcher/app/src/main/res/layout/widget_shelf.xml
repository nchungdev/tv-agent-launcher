<?xml version="1.0" encoding="utf-8"?>
<!-- Home's widget shelf, in the open space between the header and the dock. WidgetShelf places each
     card over a dock column at run time; the cards are 4dp larger than they look on every side, for
     the focus indicator. Colours come from the scheme (WidgetShelf.setPalette). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetShelf"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_shelf_height"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetClock"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/widget_hub_min_width"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/clockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="100sp" />

                    <TextClock
                        android:id="@+id/clockAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clockDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/clockLunar"
                    style="@style/WidgetDetail"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/clockDate"
                    style="@style/WidgetDetail"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#B0B3BD"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tileTemp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tileTempIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tileTempValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tileTempCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#B0B3BD"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tileLightIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tileLightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tileLightCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#B0B3BD"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileSwitch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                    
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tileSwitchIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tileSwitchValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tileSwitchCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="#B0B3BD"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/clockDividerLine"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetWeather"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/weatherPlace"
                style="@style/WidgetLabel"
                android:text="@string/weather" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/weatherTemp"
                    style="@style/WidgetValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="–" />

                <com.gathin.tvhome.core.view.ShapeBadge
                    android:id="@+id/weatherIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weatherDetail"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetContinue"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_continue_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/contLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:text="@string/widget_continue" />

                <TextView
                    android:id="@+id/contCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#B0B3BD"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/contPosterFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/continue_poster_bg">

                <ImageView
                    android:id="@+id/contPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/contRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/continue_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/contProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:max="1000" />
            </FrameLayout>

            <TextView
                android:id="@+id/contTitle"
                style="@style/WidgetTitle"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/contSubtitle"
                style="@style/WidgetDetail"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B0B3BD"
                android:textSize="12sp" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetAir"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/airLabel"
                style="@style/WidgetLabel"
                android:text="@string/air_quality" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/airValue"
                    style="@style/WidgetValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="–" />

                <com.gathin.tvhome.core.view.ShapeBadge
                    android:id="@+id/airBadge"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/airDetail"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetCalendar"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lunarLabel"
                style="@style/WidgetLabel"
                android:text="@string/lunar_calendar" />

            <TextView
                android:id="@+id/lunarDate"
                style="@style/WidgetValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/holiday"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetAdd"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_continue_height"
        android:layout_gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetAddIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add" />

            <TextView
                android:id="@+id/widgetAddLabel"
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_add" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>
</FrameLayout>
