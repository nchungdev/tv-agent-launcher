<?xml version="1.0" encoding="utf-8"?>
<!-- Home's widget shelf, in the open space between the header and the dock. WidgetShelf places each
     card over a dock column at run time; the cards are 4dp larger than they look on every side, for
     the focus indicator. Colours come from the scheme (WidgetShelf.setPalette). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetShelf"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_shelf_height"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetClock"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="56sp" />

                <TextClock
                    android:id="@+id/clockAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clockDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true"
                        android:textColor="#A78BFA"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/clockLunar"
                        style="@style/WidgetDetail"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/clockDate"
                        style="@style/WidgetDetail"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#B0B3BD"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/clockDividerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#1FFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/haStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/haHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/haLightStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:textColor="#FBBF24"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/haClimateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    
                    android:background="@drawable/widget_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:textColor="#94A3B8"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/haDetail"
                    style="@style/WidgetDetail"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:textColor="#B0B3BD"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/haOnlineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetWeather"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/weatherPlace"
                style="@style/WidgetLabel"
                android:text="@string/weather" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/weatherTemp"
                    style="@style/WidgetValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="–" />

                <com.gathin.tvhome.core.view.ShapeBadge
                    android:id="@+id/weatherIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weatherDetail"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetContinue"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/contLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="#A78BFA"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:text="@string/widget_continue" />

                <TextView
                    android:id="@+id/contCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#B0B3BD"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/contPoster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/contTitle"
                style="@style/WidgetTitle"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/contSubtitle"
                style="@style/WidgetDetail"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B0B3BD"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/contProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="1000" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetAir"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/airLabel"
                style="@style/WidgetLabel"
                android:text="@string/air_quality" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/airValue"
                    style="@style/WidgetValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="–" />

                <com.gathin.tvhome.core.view.ShapeBadge
                    android:id="@+id/airBadge"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/airDetail"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetCalendar"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lunarLabel"
                style="@style/WidgetLabel"
                android:text="@string/lunar_calendar" />

            <TextView
                android:id="@+id/lunarDate"
                style="@style/WidgetValue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/holiday"
                style="@style/WidgetDetail" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>

    <com.gathin.tvhome.feature.main.widget.WidgetCard
        android:id="@+id/widgetAdd"
        android:layout_width="0dp"
        android:layout_height="@dimen/widget_card_height"
        android:layout_gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetAddIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add" />

            <TextView
                android:id="@+id/widgetAddLabel"
                style="@style/WidgetLabel"
                android:layout_width="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_add" />
        </LinearLayout>
    </com.gathin.tvhome.feature.main.widget.WidgetCard>
</FrameLayout>
